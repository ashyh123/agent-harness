{
  "name": "minimal-agent-vercel-comparison",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "chat": "tsx cli.ts",
    "harness": "tsx harness_cli.ts",
    "harness:langgraph": "tsx harness_cli.ts",
    "router": "tsx router_cli.ts",
    "person": "tsx person_cli.ts",
    "person:delegate": "tsx router_cli.ts run --agent harness --skill person-agent --timeout 420",
    "verify:webpage": "tsx verify_webpage.ts",
    "verify:recall": "tsx verify_recall.ts",
    "verify:search": "tsx verify_search.ts",
    "verify:context": "tsx verify_context.ts",
    "verify:context-strategy": "tsx verify_context_strategy.ts",
    "verify:targeted-context": "tsx verify_targeted_context.ts",
    "verify:offload": "tsx verify_offload.ts",
    "verify:obsidian": "tsx verify_obsidian.ts",
    "verify:budget": "tsx verify_budget.ts",
    "verify:diverse": "tsx verify_diverse.ts",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "langgraph": "node --import tsx langgraph_cli.ts"
  },
  "dependencies": {
    "@ai-sdk/deepseek": "3.0.61",
    "@langchain/langgraph": "1.4.21",
    "@langchain/langgraph-checkpoint-sqlite": "1.0.4",
    "ai": "7.0.130"
  },
  "devDependencies": {
    "@types/node": "22.19.15",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
