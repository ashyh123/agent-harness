DEEPSEEK_API_KEY=""
DEEPSEEK_MODEL="deepseek-flash"
# 任务中心默认用 Jev 独占能力/复杂度分类。
TYPESAFE_API_KEY=""
# 视觉工具默认复用 DEEPSEEK_MODEL；也可以单独选择同服务的视觉模型。
VISION_MODEL="deepseek-flash"
# 可选：Agent 博客阅读专属 Obsidian vault 的绝对路径；不设置时使用 ~/Documents/Obsidian/Agent 博客阅读。
# MINIMAL_AGENT_OBSIDIAN_VAULT="/Users/your-name/Documents/Obsidian/Agent 博客阅读"
# 默认 jev-exclusive；baseline 使用原主模型分类；jev 保留主模型分类作为回退。
MINIMAL_AGENT_ROUTING_CLASSIFIER="jev-exclusive"
# jev-exclusive：主Agent提交schema不含分类字段；仅Jev提供分类，失败则不提交。
